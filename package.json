{
  "name": "matrix-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based autonomous civilization simulation built with TypeScript, React, Three.js and SQLite WASM.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaycke1337/matrix-sim.git"
  },
  "bugs": {
    "url": "https://github.com/kaycke1337/matrix-sim/issues"
  },
  "homepage": "https://github.com/kaycke1337/matrix-sim#readme",
  "keywords": [
    "simulation",
    "civilization",
    "agents",
    "reinforcement-learning",
    "threejs",
    "sqlite-wasm",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
